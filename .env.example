# ============================================================
# Kalsuq E-Commerce — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ── DATABASE ─────────────────────────────────────────────────
# PostgreSQL connection string for Prisma ORM.
# For serverless (Vercel), append connection pool params:
#   ?connection_limit=10&pool_timeout=10
DATABASE_URL="postgresql://user:password@localhost:5432/kalsuq?connection_limit=10&pool_timeout=10"

# ── AUTHENTICATION ───────────────────────────────────────────
# Used to sign/verify JWT tokens for admin and partner sessions.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-strong-random-secret-here"

# ── APPLICATION URL ──────────────────────────────────────────
# The canonical URL of your deployment. Used for Chapa callback
# and return URLs. No trailing slash.
# Local: http://localhost:3000
# Production: https://kalsuq.com
NEXTAUTH_URL="http://localhost:3000"

# ── CHAPA PAYMENT GATEWAY ────────────────────────────────────
# Secret key for server-side API calls to initialize transactions.
# Get from: https://dashboard.chapa.co → API Keys
CHAPA_SECRET_KEY="CHASECK_TEST-xxxxxxxxxxxxxxxx"

# Webhook signing secret for verifying Chapa callback authenticity.
# Configure at: https://dashboard.chapa.co → Webhooks
CHAPA_WEBHOOK_SECRET="your-webhook-signing-secret"

# ── ENVIRONMENT ──────────────────────────────────────────────
# Set to "production" on Vercel. Controls:
#   - Secure cookie flags (HttpOnly, Secure, SameSite)
#   - Prisma logging verbosity
#   - Error detail exposure
NODE_ENV="development"
