// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  USER
  PARTNER
  ADMIN
}

model Product {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  nameAm        String?
  collection    String
  collectionAm  String?
  price         Float
  originalPrice Float?
  image         String
  category      String
  categoryAm    String?
  label         String?
  labelAm       String?
  inStock       Boolean   @default(true)
  stockQuantity Int       @default(10)
  description   String    @db.Text
  descriptionAm String?   @db.Text
  sizes         String[]
  colours       Json      // Store as array of objects {name, nameAm, hex}
  images        String[]
  orderItems    OrderItem[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([category])
  @@index([createdAt])
}

model Order {
  id              String    @id @default(cuid())
  orderNumber     String    @unique // e.g., KS-12345
  items           OrderItem[]
  total           Float
  deliveryZone    String
  deliveryFee     Float
  paymentMethod   String
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus   @default(PENDING)
  customerName    String
  customerPhone   String
  customerEmail   String?
  deliveryAddress String?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([createdAt])
  @@index([paymentStatus])
  @@index([orderStatus])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  name      String
  quantity  Int
  price     Float
  size      String?
  colour    String?
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model PartnerApplication {
  id              String    @id @default(cuid())
  fullName        String
  phone           String
  email           String
  platform        String
  audienceSize    String
  promotionPlan   String?   @db.Text
  status          PartnerStatus @default(PENDING)
  createdAt       DateTime  @default(now())
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
}
