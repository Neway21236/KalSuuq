// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  USER
  PARTNER
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id                String          @id @default(cuid())
  slug              String          @unique
  sku               String?         @unique
  name              String
  nameAm            String?
  shortDescription  String?         @db.Text
  description       String          @db.Text
  descriptionAm     String?         @db.Text
  collection        String
  collectionAm      String?
  category          String
  categoryAm        String?
  tags              String[]
  
  // Pricing
  price             Float           // Current price (Sale price if on sale)
  originalPrice     Float?          // Base price (before discount)
  
  // Status & Visibility
  status            ProductStatus   @default(DRAFT)
  isFeatured        Boolean         @default(false)
  isBestSeller      Boolean         @default(false)
  
  // Media
  image             String          // Main image
  images            String[]        // Up to 8 images
  
  // Inventory (Legacy/Single Variant)
  inStock           Boolean         @default(true)
  stockQuantity     Int             @default(10)
  lowStockThreshold Int             @default(3)
  
  // Variants
  variants          ProductVariant[]
  
  // Relationships
  orderItems        OrderItem[]
  
  // Recommendations (Self-relation)
  recommendations   Product[]       @relation("ProductRecommendations")
  recommendedBy     Product[]       @relation("ProductRecommendations")
  
  // Bundles (Self-relation)
  isBundle          Boolean         @default(false)
  bundleProducts    Product[]       @relation("BundleProducts")
  partOfBundles     Product[]       @relation("BundleProducts")
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([category])
  @@index([createdAt])
  @@index([status])
}

model ProductVariant {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String?   @unique
  size          String?
  colour        String?
  colourHex     String?
  price         Float?    // Distinct price if different from base
  stock         Int       @default(0)
  image         String?   // Specific image for this variant
  
  orderItems    OrderItem[]
  adjustments   StockAdjustment[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model StockAdjustment {
  id            String    @id @default(cuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  amount        Int       // positive for addition, negative for subtraction
  reason        String    // Required note
  adminId       String
  createdAt     DateTime  @default(now())
}

enum OrderStatus {
  PENDING_CONFIRMATION
  PAYMENT_CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id              String    @id @default(cuid())
  orderNumber     String    @unique // e.g., KS-12345
  items           OrderItem[]
  total           Float
  deliveryZone    String    // Addis / Nationwide
  deliveryType    String?   // Standard / Express
  deliveryFee     Float
  paymentMethod   String    // Chapa / COD
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus   @default(PENDING_CONFIRMATION)
  customerName    String
  customerPhone   String
  customerEmail   String?
  deliveryAddress String?
  latitude        Float?
  longitude       Float?
  partnerCode     String?   // Referral / Influencer code
  trackingLink    String?   // External courier tracking
  internalNotes   String?   @db.Text
  
  // JSON array of { status: string, timestamp: string, note: string }
  statusHistory   Json?     @default("[]")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([createdAt])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([partnerCode])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  name      String
  quantity  Int
  price     Float
  size      String?
  colour    String?
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model PartnerApplication {
  id              String    @id @default(cuid())
  fullName        String
  phone           String
  email           String
  platform        String
  audienceSize    String
  promotionPlan   String?   @db.Text
  status          PartnerStatus @default(PENDING)
  createdAt       DateTime  @default(now())
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
}
